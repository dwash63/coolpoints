rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(db)/documents/users/$(uid); }

    // ---------- Profiles ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'bio', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 100
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(db)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio'])
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 100;
      allow delete: if false;
    }

    // ---------- Username claims (keeps usernames unique) ----------
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.usernameLower == name;
      allow update, delete: if false;
    }

    // ---------- Ratings: one per person per person, 1-100, can be updated ----------
    // Document id is "<raterId>_<ratedId>", so each person can only ever have
    // one rating for someone else.
    match /ratings/{rid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'fromName', 'to', 'toName', 'score', 'note', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && rid == request.auth.uid + '_' + request.resource.data.to
        && exists(userPath(request.resource.data.to))
        && request.resource.data.fromName == get(userPath(request.auth.uid)).data.username
        && request.resource.data.toName == get(userPath(request.resource.data.to)).data.username
        && request.resource.data.score is int
        && request.resource.data.score >= 1 && request.resource.data.score <= 100
        && request.resource.data.note is string && request.resource.data.note.size() <= 140
        && request.resource.data.at == request.time;
      allow delete: if false;
    }
  }
}
